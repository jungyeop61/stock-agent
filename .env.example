# 이 파일에는 실제 비밀값을 입력하지 마세요.
# 로컬에서 사용할 때 .env로 복사하고 .env만 수정하세요.

TZ=Asia/Seoul

# PostgreSQL 개발 환경
POSTGRES_DB=jusika
POSTGRES_USER=jusika
POSTGRES_PASSWORD=로컬에서_변경할_비밀번호
POSTGRES_PORT=5432

# Spring Backend
SPRING_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jusika
SPRING_DATASOURCE_USERNAME=jusika
SPRING_DATASOURCE_PASSWORD=로컬에서_변경할_비밀번호

# PostgreSQL 통합 테스트 전용 환경입니다. DB 이름에는 test 또는 integration이 반드시 포함되어야 합니다.
RUN_JUSIKA_POSTGRES_TEST=false
JUSIKA_TEST_POSTGRES_URL=jdbc:postgresql://localhost:55432/jusika_integration_test
JUSIKA_TEST_POSTGRES_USERNAME=jusika_test
JUSIKA_TEST_POSTGRES_PASSWORD=통합테스트에서만_사용할_비밀번호
JUSIKA_TEST_POSTGRES_PORT=55432
# Python Agent 체크포인트 재시작 복구 통합 테스트도 같은 격리 DB 컨테이너를 사용합니다.
RUN_JUSIKA_AGENT_POSTGRES_TEST=false
JUSIKA_AGENT_TEST_POSTGRES_URL=postgresql://jusika_test:통합테스트에서만_사용할_비밀번호@localhost:55432/jusika_integration_test
# 내부 API 키가 비어 있으면 계좌·주문 API를 기본 차단합니다.
# 실제 값은 Git에 저장하지 말고 각 실행 환경에서 긴 무작위 값으로 설정합니다.
JUSIKA_INTERNAL_READ_API_KEY=
JUSIKA_INTERNAL_ORDER_API_KEY=
JUSIKA_BROKER_MODE=mock
# 실제 주문 기능은 기본 비활성화하며 사용자의 명시적 허락 전에는 true로 바꾸지 않습니다.
JUSIKA_LIVE_TRADING_ENABLED=false
# 긴급 주문 차단 스위치는 기본 활성화 상태를 유지합니다.
JUSIKA_TRADING_KILL_SWITCH_ACTIVE=true
# 실제 주문을 허용할 계좌 식별값 목록입니다. 명시적 허락 전에는 비워 둡니다.
JUSIKA_LIVE_ALLOWED_ACCOUNT_SEQS=
# LIVE 생성·정정을 허용할 시장별 종목 목록입니다. 예: KR:005930,US:AAPL
JUSIKA_LIVE_ALLOWED_INSTRUMENTS=
# 실제 주문 1회 한도이며 명시적 승인 전에는 미설정을 뜻하는 0으로 유지합니다.
JUSIKA_LIVE_MAX_ORDER_QUANTITY=0
JUSIKA_LIVE_MAX_KRW_ORDER_AMOUNT=0
JUSIKA_LIVE_MAX_USD_ORDER_AMOUNT=0
# 실제 주문의 한국시간 하루 누적 한도이며 명시적 승인 전에는 0으로 유지합니다.
JUSIKA_LIVE_MAX_DAILY_ORDER_QUANTITY=0
JUSIKA_LIVE_MAX_DAILY_KRW_ORDER_AMOUNT=0
JUSIKA_LIVE_MAX_DAILY_USD_ORDER_AMOUNT=0
# LIVE 계좌 전체와 동일 종목의 활성 일반·조건 주문 상한이며 승인 전에는 0으로 유지합니다.
JUSIKA_LIVE_MAX_OPEN_ORDERS_PER_ACCOUNT=0
JUSIKA_LIVE_MAX_OPEN_ORDERS_PER_INSTRUMENT=0
# LIVE 신규 주문·정정·복구의 계좌 전체와 동일 종목 1분 상한이며 0이면 차단합니다.
JUSIKA_LIVE_MAX_MUTATIONS_PER_ACCOUNT_PER_MINUTE=0
JUSIKA_LIVE_MAX_MUTATIONS_PER_INSTRUMENT_PER_MINUTE=0
# 기능별 실제 주문 어댑터 준비 상태는 사용자의 명시적 허락 전까지 모두 false로 유지합니다.
JUSIKA_LIVE_QUANTITY_ORDER_SUBMISSION_CONNECTED=false
JUSIKA_LIVE_AMOUNT_ORDER_SUBMISSION_CONNECTED=false
JUSIKA_LIVE_NORMAL_ORDER_CANCELLATION_CONNECTED=false
JUSIKA_LIVE_NORMAL_ORDER_MODIFICATION_CONNECTED=false
JUSIKA_LIVE_SINGLE_CONDITIONAL_ORDER_CREATION_CONNECTED=false
JUSIKA_LIVE_OCO_CONDITIONAL_ORDER_CREATION_CONNECTED=false
JUSIKA_LIVE_OTO_CONDITIONAL_ORDER_CREATION_CONNECTED=false
JUSIKA_LIVE_CONDITIONAL_ORDER_CANCELLATION_CONNECTED=false
JUSIKA_LIVE_CONDITIONAL_ORDER_MODIFICATION_CONNECTED=false
# 주문 미리보기 승인 유효시간이며 기본값은 2분입니다.
ORDER_PREVIEW_EXPIRATION=2m

# Python Agent
JUSIKA_AGENT_ENVIRONMENT=local
JUSIKA_AGENT_SPRING_BACKEND_URL=http://localhost:8080
JUSIKA_AGENT_PORT=8000
# API 키 없이 MOCK E2E를 검증할 때는 rules를 사용합니다. 실제 LLM 해석은 openai로 바꿉니다.
JUSIKA_AGENT_COMMAND_INTERPRETER=rules
JUSIKA_AGENT_OPENAI_MODEL=gpt-4o-mini
# 로컬 기본값은 memory입니다. 재시작 후 승인 대기를 복구하려면 postgres와 전용 URL을 사용합니다.
JUSIKA_AGENT_CHECKPOINT_PROVIDER=memory
JUSIKA_AGENT_CHECKPOINT_DATABASE_URL=
OPENAI_API_KEY=

# 토스증권 인증정보는 Spring Backend에서만 사용합니다.
TOSSINVEST_BASE_URL=https://openapi.tossinvest.com
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
